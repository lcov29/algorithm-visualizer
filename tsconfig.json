{
  "compilerOptions": {
    "outDir": "./dist/",
    "baseUrl": "./node_modules",
    "module": "esnext",
    "moduleResolution": "node",
    "target": "esnext",
    "jsx": "react",
    "lib": ["dom", "esnext"],
    "sourceMap": true,
    "strict": true,
    "pretty": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "resolveJsonModule": true,
    "paths": {
      // prevent VS Code autocompletion to display relative module paths
      "@algorithm-visualizer/app": ["../packages/app"],
      "@algorithm-visualizer/data-validation": [
        "../packages/implementations/cross-cutting-concerns/data-validation"
      ],
      "@algorithm-visualizer/data-validation-contract": [
        "../packages/contracts/cross-cutting-concerns/data-validation"
      ],
      "@algorithm-visualizer/error-handling-contract": [
        "../packages/contracts/cross-cutting-concerns/error-handling"
      ],
      "@algorithm-visualizer/event-handling": [
        "../packages/implementations/cross-cutting-concerns/event-handling"
      ],
      "@algorithm-visualizer/event-handling-contract": [
        "../packages/contracts/cross-cutting-concerns/event-handling"
      ],
      "@algorithm-visualizer/graph": [
        "../packages/implementations/data-structures/graph"
      ],
      "@algorithm-visualizer/graph-contract": [
        "../packages/contracts/data-structures/graph"
      ],
      "@algorithm-visualizer/integer-range-contract": [
        "../packages/contracts/data-structures/integer-range"
      ],
      "@algorithm-visualizer/randomization": [
        "../packages/implementations/cross-cutting-concerns/randomization"
      ],
      "@algorithm-visualizer/randomization-contract": [
        "../packages/contracts/cross-cutting-concerns/randomization"
      ]
    }
  },
  "include": ["./packages/**/*", "__mocks__"]
}
